; Open this folder as a Godot 4.5+ project. The classroom scene is reusable separately.
config_version=5

[application]
config/name="Our Classroom — First Light"
run/main_scene="res://demo/walkthrough.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.75, 0.8, 0.76, 1)
